# Copie para .env.local e preencha. NUNCA commitar valores reais.

# Connection string do Neon Postgres (região aws-sa-east-1 / São Paulo)
DATABASE_URL=

# Senha única de acesso ao dashboard (forte, distinta das demais)
DASHBOARD_PASSWORD=

# Chave da API de ingestão (header x-api-key) — forte, distinta das demais
INGEST_API_KEY=

# Segredo para assinar o cookie de sessão (>= 32 caracteres aleatórios)
SESSION_SECRET=

# --- opcionais (defaults entre parênteses) ---
# TENANT_ID=otogama                  (otogama)
# RATE_LIMIT_POR_MINUTO=60           (60)
# PENDENTE_APOS_HORAS=4              (4)  horas sem resposta para virar "pendente"
# MINUTOS_POR_LEMBRETE=3             (3)  minutos poupados por lembrete enviado
# MINUTOS_POR_CONFIRMACAO=2          (2)  minutos poupados por confirmação processada
# MINUTOS_POR_AGENDAMENTO_IA=8       (8)  minutos poupados por agendamento da IA
